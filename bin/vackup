#!/usr/bin/env bash

set -e

IMAGE="ubuntu:24.04"

_error() {
    echo "Error: $1" >&2
    exit 1
}

vol_backup() {
    if [ -z "$1" ]; then
        _error "use: backup <volume> [file.tar.gz]"
    fi
    
    VOLUME="$1"
    FILE="${2:-$VOLUME.tar.gz}"
    
    docker volume inspect "$VOLUME" >/dev/null 2>&1 || {
        _error "volume does not exist"
    }
    
    docker run --rm \
    -v "${VOLUME}:/source:ro" \
    -v "$(pwd):/backup" \
    "$IMAGE" \
    tar czf "/backup/$(basename "$FILE")" -C /source .
}

vol_restore() {
    if [ -z "$1" ]; then
        _error "use: restore <volume> [file.tar.gz]"
    fi
    
    VOLUME="$1"
    FILE="${2:-$VOLUME.tar.gz}"
    
    [ -f "$FILE" ] || {
        _error "file does not exist"
    }
    
    docker volume inspect "$VOLUME" >/dev/null 2>&1 || {
        docker volume create "$VOLUME"
    }
    
    docker run --rm \
    -v "${VOLUME}:/target" \
    -v "$(pwd):/backup" \
    "$IMAGE" \
    tar xzf "/backup/$(basename "$FILE")" -C /target
}

vol_clone() {
    if [ -z "$1" ] || [ -z "$2" ]; then
        _error "use: $0 clone volumen-source volumen-destination"
    fi
    
    SRC="$1"
    DST="$2"
    
    docker volume inspect "$SRC" >/dev/null 2>&1 || {
        _error "volume dont exist"
    }
    
    docker volume inspect "$DST" >/dev/null 2>&1 || {
        docker volume create "$DST"
    }
    
    docker run --rm \
    -v "${SRC}:/source:ro" \
    -v "${DST}:/target" \
    "$IMAGE" \
    cp -a /source/. /target/
}

case "${1:-}" in
    backup)
        shift
        vol_backup "$@"
    ;;
    restore)
        shift
        vol_restore "$@"
    ;;
    clone)
        shift
        vol_clone "$@"
    ;;
    *)
        _error "commands: [backup, restore, clone]"
    ;;
esac
